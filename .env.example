# VALENCE-X Root Environment Configuration Example
# Copy to backend/.env for server execution

PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=unlisted_securities_exchange
DB_PORT=3307

# Frontend Environment Variable (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
