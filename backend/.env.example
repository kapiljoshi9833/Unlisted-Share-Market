# VALENCE-X Backend Environment Configuration Example
# Copy this file to .env and adjust credentials for your environment

PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=unlisted_securities_exchange
DB_PORT=3307

# Frontend Origin for CORS (Optional)
CORS_ORIGIN=http://localhost:5173
